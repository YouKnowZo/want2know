modules = ["nodejs-20", "python-3.11"]
hidden = [".config", "package-lock.json"]
run = "npm run start"

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-23_05"
packages = ["xcodebuild", "zlib"]

[unitTest]
language = "nodejs"

[deployment]
run = ["sh", "-c", "APP_AUTH_REQUIRED=true npm run start"]
deploymentTarget = "cloudrun"
ignorePorts = false

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 9005
externalPort = 80
exposeLocalhost = true

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node app.js --gui"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
